# Telegram (required)
TELEGRAM_BOT_TOKEN=

# Lark Suite (required)
LARK_APP_ID=
LARK_APP_SECRET=

# OpenAI (required)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Cohere (required, reranking)
COHERE_API_KEY=

# Qdrant
QDRANT_URL=http://qdrant:6333

# App
DB_PATH=data/history.db
TIMEZONE=Asia/Ho_Chi_Minh
RECENT_MESSAGES=8
RAG_MESSAGES=5

# Zalo channel (optional, single-account demo)
# 1. cd src/channels/zalo_bridge && npm install && node login.js   ← scan QR once
# 2. set ZALO_ENABLED=true. session.json next to bridge.js is auto-loaded.
# 3. (Docker) copy session.json into ./data/zalo/ and override ZALO_SESSION_PATH.
ZALO_ENABLED=false
ZALO_NODE_PATH=node
ZALO_SESSION_PATH=
