# ============================================================
# SMART_bot — cấu hình môi trường
# Copy file này thành .env rồi điền giá trị.
# ============================================================

# --- Hạ tầng (Docker: bash scripts/restart.sh tự bật) -------
POSTGRES_DSN=postgresql://smart:smart@localhost:5433/smart_bot
QDRANT_URL=http://localhost:6333

# --- Bảo mật phiên đăng nhập --------------------------------
# SESSION_SECRET: chuỗi ngẫu nhiên  → python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# FERNET_KEY: khoá mã hoá API key trong DB → python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_SECRET=
FERNET_KEY=

# --- Đăng nhập Google (tuỳ chọn — bỏ trống nếu chỉ dùng email/password)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_WHITELIST=http://localhost:8000/api/oauth/google/callback

# --- Superadmin ---------------------------------------------
# Email đăng nhập Google khớp danh sách này sẽ có quyền superadmin (phân cách bằng dấu phẩy)
SUPERADMIN_EMAILS=

# ============================================================
# API KEY CHO LLM — bot cần ít nhất 1 key để trả lời
# ============================================================
# OpenAI (model smart + vision, vd gpt-4o) — lấy tại https://platform.openai.com/api-keys
# (chấp nhận cả tên OPENAI_API_KEY)
PLATFORM_OPENAI_API_KEY=sk-...
# Groq (model fast, vd llama-3.3-70b) — lấy tại https://console.groq.com/keys
# (chấp nhận cả tên GROQ_API_KEY)
PLATFORM_GROQ_API_KEY=gsk_...
# Lưu ý: đây là key NỀN TẢNG (dùng chung cả hệ thống). Từng sếp có thể tự
# nhập key riêng (BYO) trong web admin: Cài đặt > AI — key riêng được ưu tiên.

# --- Thông tin chuyển khoản (hiện trong modal đăng ký gói) ---
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_BIN=

# --- Khác ----------------------------------------------------
# Trần chi phí AI mặc định cho boss mới (USD/ngày)
DEFAULT_BOSS_COST_CAP_USD_DAILY=5
# Ghi nội dung tin nhắn thô vào log (chỉ bật khi debug)
LOG_RAW_CONTENT=false
# Kênh web test (giả lập nhân viên/nhóm) — tắt ở production
ENABLE_WEB_TEST_CHANNEL=true
