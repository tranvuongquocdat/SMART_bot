#!/usr/bin/env bash
# pre-commit gate: lint the Python files being committed. ruff only, so it's
# fast enough to run on every commit. Scoped to STAGED files — you only get
# blocked on code you actually touched, never on pre-existing debt elsewhere.
#
# Install once per clone:  git config core.hooksPath scripts/git-hooks
# Bypass in a real emergency:  git commit --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Staged Python files (Added/Copied/Modified — ignore deletions/renames-away).
staged_py="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)"
[ -z "$staged_py" ] && exit 0

if ! echo "$staged_py" | xargs uv run ruff check; then
  {
    echo
    echo "✋ pre-commit blocked: ruff found lint errors in the staged Python files above."
    echo "  Auto-fix the easy ones:  uv run ruff check --fix <file>"
    echo "  Bypass (risky):          git commit --no-verify"
  } >&2
  exit 1
fi
exit 0
